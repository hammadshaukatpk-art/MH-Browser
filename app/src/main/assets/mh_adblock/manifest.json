{
 "manifest_version":2,
 "name":"MH Browser Content Protection",
 "version":"1.0.0",
 "applications":{"gecko":{"id":"mh-adblock@mh-browser"}},
 "permissions":["webRequest","webRequestBlocking","<all_urls>","storage","nativeMessaging"],
 "background":{"scripts":["background.js"]},
 "content_scripts":[{"matches":["<all_urls>"],"js":["cosmetic.js"],"run_at":"document_start","all_frames":true}],
 "web_accessible_resources":["ad_domains.txt","ad_paths.txt"]
}